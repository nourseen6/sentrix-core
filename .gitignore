# Local secrets and machine config. No application source is in this
# workspace yet. These rules are here so later commits do not pick up
# credentials, dataset copies, or model binaries by accident.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
**/secrets/

# Research copies and trained artifacts. Keep them out of git unless a
# dataset license explicitly allows redistribution.
data/raw/
data/private/
data/processed/
models/*.tflite
models/*.onnx
models/*.bin
models/*.pt
models/*.pth

# Local project files that are not published in this repository.
SENTRIX_CORE_Research_Paper_v2.1 (1).pdf
SentriX_Core_Collaboration_Brief.html
SentriX_Core_Collaboration_Brief.pdf
sentrix-logo.png
README.md
sentrix.docx
~$*
SENTRIX_CORE_Funding_Proposal_Form.html
SENTRIX_CORE_Funding_Proposal_Form.pdf
SENTRIX_CORE_Project_Funding_Proposal.html
SENTRIX_CORE_Project_Funding_Proposal.pdf
SENTRIX_CORE_University_Proposal.html
SENTRIX_CORE_University_Proposal.pdf
funding_form_assets/
